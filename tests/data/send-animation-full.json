{
  "http_method": "POST",
  "url_path": "sendAnimation",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "animation": "file-id",
      "allow_paid_broadcast": true,
      "business_connection_id": "id",
      "caption": "Caption",
      "parse_mode": "Markdown",
      "callback_query_id": "cqid",
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "duration": 100,
      "has_spoiler": true,
      "height": 300,
      "message_effect_id": "effect-id",
      "message_thread_id": 1,
      "protect_content": true,
      "receiver_user_id": 999,
      "reply_markup": {
        "force_reply": true
      },
      "reply_parameters": {
        "message_id": 1
      },
      "show_caption_above_media": true,
      "suggested_post_parameters": {},
      "thumbnail": "https://google.com/favicon.ico",
      "width": 200
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "animation": {
        "file_id": "file-id",
        "file_unique_id": "uid",
        "width": 200,
        "height": 300,
        "duration": 100,
        "thumbnail": {
          "file_id": "thumb-file-id",
          "file_unique_id": "tuid",
          "width": 200,
          "height": 300,
          "file_size": 100
        },
        "file_name": "test",
        "mime_type": "video/mp4",
        "file_size": 10000
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
