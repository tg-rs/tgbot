{
  "http_method": "POST",
  "url_path": "sendAudio",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "audio": "file-id",
      "caption": "caption",
      "caption_entities": [
        {
          "type": "bold",
          "offset": 0,
          "length": 2
        }
      ]
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "audio": {
        "file_id": "file-id",
        "file_unique_id": "uid",
        "duration": 20
      },
      "caption": "caption",
      "caption_entities": [
        {
          "type": "bold",
          "offset": 0,
          "length": 2
        }
      ],
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
