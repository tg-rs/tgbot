{
  "http_method": "POST",
  "url_path": "sendLivePhoto",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "live_photo": "file-id",
      "photo": "photo-id"
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "live_photo": {
        "photo": [
          {
            "file_id": "fid",
            "file_unique_id": "fuid",
            "width": 200,
            "height": 200
          }
        ],
        "file_id": "file-id",
        "file_unique_id": "fuid",
        "width": 200,
        "height": 200,
        "duration": 10
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
