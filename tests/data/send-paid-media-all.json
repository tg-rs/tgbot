{
  "http_method": "POST",
  "url_path": "sendPaidMedia",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "media": [
        {
          "type": "photo",
          "media": "file-id"
        },
        {
          "type": "live_photo",
          "media": "media-id",
          "photo": "photo-id"
        },
        {
          "type": "video",
          "media": "attach://tgbot_file_1"
        },
        {
          "type": "video",
          "media": "attach://tgbot_file_2",
          "cover": "test-cover",
          "duration": 10,
          "height": 200,
          "start_timestamp": 0,
          "supports_streaming": true,
          "thumbnail": "test-thumbnail",
          "width": 200
        }
      ],
      "star_count": 100,
      "allow_paid_broadcast": true,
      "business_connection_id": "c-id",
      "caption": "caption",
      "caption_entities": [
        {
          "type": "bold",
          "offset": 0,
          "length": 1
        }
      ],
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "message_thread_id": 1,
      "payload": "payload",
      "protect_content": true,
      "reply_parameters": {
        "message_id": 1
      },
      "reply_markup": {
        "force_reply": true
      },
      "suggested_post_parameters": {},
      "show_caption_above_media": true,
      "tgbot_file_1": "test-video-1",
      "tgbot_file_2": "test-video-2"
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "paid_media": {
        "star_count": 100,
        "paid_media": [
          {
            "type": "photo",
            "photo": [
              {
                "file_id": "file-id",
                "file_unique_id": "fuid",
                "width": 200,
                "height": 200
              }
            ]
          },
          {
            "type": "live_photo",
            "live_photo": {
              "photo": [
                {
                  "file_id": "fid",
                  "file_unique_id": "fuid",
                  "width": 200,
                  "height": 200
                }
              ],
              "file_id": "file-id",
              "file_unique_id": "fuid",
              "width": 200,
              "height": 200,
              "duration": 10
            }
          },
          {
            "type": "video",
            "video": {
              "file_id": "file-id",
              "file_unique_id": "file-unique-id",
              "width": 200,
              "height": 200,
              "duration": 10
            }
          },
          {
            "type": "preview",
            "width": 200,
            "height": 200,
            "duration": 10
          }
        ]
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}