{
  "http_method": "POST",
  "url_path": "sendPaidMedia",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "media": [
        {
          "type": "photo",
          "media": "file-id"
        }
      ],
      "star_count": 100
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "paid_media": {
        "star_count": 100,
        "paid_media": [
          {
            "type": "photo",
            "photo": [
              {
                "file_id": "file-id",
                "file_unique_id": "fuid",
                "width": 200,
                "height": 200
              }
            ]
          }
        ]
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
