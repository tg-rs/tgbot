        "media": [
          {
            "id": "id",
            "media": {
              "media": "test",
              "type": "animation"
            }
          }
        ]
      },
      "suggested_post_parameters": {}
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
