      },
      "rich_message": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "test"
          },
          {
            "type": "animation",
            "animation": {
              "file_id": "file-id",
              "file_unique_id": "file-unique-id",
              "width": 200,
              "height": 200,
              "duration": 10
            }
          }
        ]
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
