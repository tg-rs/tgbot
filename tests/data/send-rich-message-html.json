{
  "http_method": "POST",
  "url_path": "sendRichMessage",
  "req_body": {
    "multipart": {
      "allow_paid_broadcast": true,
      "business_connection_id": "test",
      "chat_id": 1,
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "message_effect_id": "test",
      "message_thread_id": 1,
      "protect_content": true,
      "reply_markup": {
        "force_reply": true
      },
      "reply_parameters": {
        "message_id": 1
      },
      "rich_message": {
        "html": "test",
