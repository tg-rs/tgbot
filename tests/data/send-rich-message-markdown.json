{
  "http_method": "POST",
  "url_path": "sendRichMessage",
  "req_body": {
    "multipart": {
      "chat_id": 1,
      "rich_message": {
        "markdown": "test",
        "skip_entity_detection": true
      }
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "rich_message": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "test"
          }
        ]
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
