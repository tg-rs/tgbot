        "is_video": false,
        "thumbnail": {
          "file_id": "tfid",
          "file_unique_id": "tfuid",
          "width": 100,
          "height": 100
        },
        "emoji": "test",
        "set_name": "test",
        "premium_animation": {
          "file_id": "fid",
          "file_unique_id": "fuid"
        },
        "mask_position": {
          "point": "forehead",
          "x_shift": 0.0,
          "y_shift": 0.0,
          "scale": 1.0
        },
        "custom_emoji_id": "test",
        "needs_repainting": true,
        "file_size": 10000
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}