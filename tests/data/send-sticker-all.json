{
  "http_method": "POST",
  "url_path": "sendSticker",
  "req_body": {
    "multipart": {
      "allow_paid_broadcast": true,
      "business_connection_id": "id",
      "chat_id": 1,
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "ephemeral_message_parameters": {
        "receiver_user_id": 999
      },
      "emoji": "😱",
      "message_effect_id": "effect-id",
      "message_thread_id": 1,
