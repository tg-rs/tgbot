{
  "http_method": "POST",
  "url_path": "sendVideoNote",
  "req_body": {
    "multipart": {
      "allow_paid_broadcast": true,
      "business_connection_id": "id",
      "callback_query_id": "cqid",
      "chat_id": 1,
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "duration": 50,
      "length": 100,
      "message_effect_id": "effect-id",
      "message_thread_id": 1,
      "protect_content": true,
      "receiver_user_id": 999,
      "reply_markup": {
        "force_reply": true
      },
      "reply_parameters": {
        "message_id": 1
      },
      "suggested_post_parameters": {},
      "thumbnail": "https://example.com/image.jpg",
      "video_note": "file-id"
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "video_note": {
        "file_id": "file-id",
        "file_unique_id": "file-unique-id",
        "length": 100,
        "duration": 200,
        "file_size": 10000,
        "thumbnail": {
          "file_id": "tfid",
          "file_unique_id": "tfuid",
          "width": 200,
          "height": 200
        }
      },
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}
