{
  "http_method": "POST",
  "url_path": "sendVoice",
  "req_body": {
    "multipart": {
      "allow_paid_broadcast": true,
      "business_connection_id": "id",
      "caption": "Caption",
      "chat_id": 1,
      "direct_messages_topic_id": 1,
      "disable_notification": true,
      "ephemeral_message_parameters": {
        "receiver_user_id": 999
      },
      "duration": 100,
      "message_effect_id": "effect-id",
      "message_thread_id": 1,
      "parse_mode": "Markdown",
      "protect_content": true,
      "reply_markup": {
        "force_reply": true
      },
      "reply_parameters": {
        "message_id": 1
      },
      "suggested_post_parameters": {},
      "voice": "file-id"
    }
  },
  "rep_body": {
    "ok": true,
    "result": {
      "message_id": 1,
      "date": 0,
      "chat": {
        "type": "group",
        "id": 1,
        "title": "Test"
      },
      "from": {
        "id": 1,
        "first_name": "John",
        "is_bot": false
      },
      "voice": {
        "file_id": "file-id",
        "file_unique_id": "file-unique-id",
        "duration": 100,
        "mime_type": "audio/mpeg",
        "file_size": 10000
      },
      "caption": "caption",
      "caption_entities": [
        {
          "type": "bold",
          "offset": 0,
          "length": 2
        }
      ],
      "is_automatic_forward": false,
      "has_protected_content": false
    }
  }
}